{
  "version": 2,
  "functions": {
    "src/main.ts": {
      "runtime": "nodejs20.x",
      "includeFiles": "node_modules/@nestjs/config/**"
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "src/main.ts",
      "methods": ["GET", "POST", "PUT", "DELETE", "PATCH", "OPTIONS"],
      "headers": {
        "Access-Control-Allow-Origin": "*"
      }
    }
  ]
}
